<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="Playback">
        <SwitchPreferenceCompat app:key="autoplay" app:title="Autoplay" app:defaultValue="true" />
        <SwitchPreferenceCompat app:key="restore_last_session" app:title="Restore last session" app:defaultValue="true" />
        <ListPreference app:key="audio_quality" app:title="Audio quality" app:defaultValue="best" app:entries="@array/audio_quality_entries" app:entryValues="@array/audio_quality_values" />
    </PreferenceCategory>
    <PreferenceCategory app:title="DSP">
        <SwitchPreferenceCompat app:key="dsp_enabled_default" app:title="Enable DSP by default" app:defaultValue="true" />
        <ListPreference app:key="dsp_preset" app:title="Default preset" app:defaultValue="flat" app:entries="@array/dsp_preset_names" app:entryValues="@array/dsp_preset_values" />
    </PreferenceCategory>
    <PreferenceCategory app:title="Downloads">
        <SwitchPreferenceCompat app:key="downloads_enabled" app:title="Allow offline downloads" app:defaultValue="true" />
        <ListPreference app:key="download_location" app:title="Download location" app:defaultValue="app_private" app:entries="@array/download_location_entries" app:entryValues="@array/download_location_values" />
    </PreferenceCategory>
    <PreferenceCategory app:title="Fallbacks">
        <SwitchPreferenceCompat app:key="webview_fallback_enabled" app:title="Enable ad-blocked WebView fallback" app:defaultValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
