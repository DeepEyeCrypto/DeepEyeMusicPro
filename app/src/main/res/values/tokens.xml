<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 Dynamic Color Palette (Tokens) -->
    
    <!-- Primary -->
    <color name="m3_primary">@android:color/system_accent1_600</color>
    <color name="m3_on_primary">@android:color/system_accent1_0</color>
    <color name="m3_primary_container">@android:color/system_accent1_100</color>
    <color name="m3_on_primary_container">@android:color/system_accent1_900</color>
    
    <!-- Secondary -->
    <color name="m3_secondary">@android:color/system_accent2_600</color>
    <color name="m3_on_secondary">@android:color/system_accent2_0</color>
    <color name="m3_secondary_container">@android:color/system_accent2_100</color>
    <color name="m3_on_secondary_container">@android:color/system_accent2_900</color>
    
    <!-- Tertiary -->
    <color name="m3_tertiary">@android:color/system_accent3_600</color>
    <color name="m3_on_tertiary">@android:color/system_accent3_0</color>
    <color name="m3_tertiary_container">@android:color/system_accent3_100</color>
    <color name="m3_on_tertiary_container">@android:color/system_accent3_900</color>
    
    <!-- Error -->
    <color name="m3_error">#FFB3261E</color>
    <color name="m3_on_error">#FFFFFFFF</color>
    <color name="m3_error_container">#FFF9DEDC</color>
    <color name="m3_on_error_container">#FF410E0B</color>
    
    <!-- Surface -->
    <color name="m3_surface">@android:color/system_neutral1_0</color>
    <color name="m3_on_surface">@android:color/system_neutral1_900</color>
    <color name="m3_surface_variant">@android:color/system_neutral2_100</color>
    <color name="m3_on_surface_variant">@android:color/system_neutral2_700</color>
    
    <!-- Surface Containers (Material 3 Expressive NEW) -->
    <color name="m3_surface_container_lowest">@android:color/system_neutral1_0</color>
    <color name="m3_surface_container_low">@android:color/system_neutral1_50</color>
    <color name="m3_surface_container">@android:color/system_neutral1_100</color>
    <color name="m3_surface_container_high">@android:color/system_neutral1_200</color>
    <color name="m3_surface_container_highest">@android:color/system_neutral1_300</color>
    
    <!-- Inverse -->
    <color name="m3_inverse_surface">@android:color/system_neutral1_800</color>
    <color name="m3_inverse_on_surface">@android:color/system_neutral1_50</color>
    <color name="m3_inverse_primary">@android:color/system_accent1_200</color>
    
    <!-- Outline -->
    <color name="m3_outline">@android:color/system_neutral2_500</color>
    <color name="m3_outline_variant">@android:color/system_neutral2_200</color>
    
    <!-- Surface Tint (tonal elevation) -->
    <color name="m3_surface_tint">@color/m3_primary</color>
    
    <!-- Custom Music-Specific Tokens -->
    <color name="music_scrim">#99000000</color>
    <color name="music_ripple">@color/m3_primary_container</color>
    <color name="music_equalizer_bar">@color/m3_primary</color>
    <color name="music_progress_bg">@color/m3_surface_container_highest</color>
    <color name="music_progress_fill">@color/m3_primary</color>
    <color name="music_play_button_bg">@color/m3_primary_container</color>
    <color name="music_play_button_icon">@color/m3_on_primary_container</color>
</resources>
