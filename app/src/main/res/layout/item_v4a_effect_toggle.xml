<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/deep_surface_elevated"
    app:cardCornerRadius="20dp"
    app:strokeColor="@color/deep_outline"
    app:strokeWidth="1dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/effectTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/deep_text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/effectSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/deep_text_secondary" android:textSize="12sp" />
        </LinearLayout>
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/effectSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
