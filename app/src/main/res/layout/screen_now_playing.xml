<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_backdrop"
    android:padding="24dp">

    <!-- Artwork Section -->
    <ImageView
        android:id="@+id/artworkImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.80"
        app:layout_constraintHeight_max="360dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/titleText"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.4"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_artwork_rounded"
        android:scaleType="centerCrop"
        android:contentDescription="@string/screen_now_playing" />

    <!-- Metadata Section -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:textColor="@color/deep_text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:ellipsize="marquee"
        android:singleLine="true"
        app:layout_constraintTop_toBottomOf="@+id/artworkImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/artistText" />

    <TextView
        android:id="@+id/artistText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/deep_text_secondary"
        android:textSize="16sp"
        android:ellipsize="end"
        android:singleLine="true"
        app:layout_constraintTop_toBottomOf="@+id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/seekBar" />

    <!-- Seek Section -->
    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:thumb="@drawable/seekbar_thumb"
        android:thumbTint="@color/cyan_accent"
        android:progressTint="@color/cyan_accent"
        android:progressBackgroundTint="#26FFFFFF"
        android:minHeight="6dp"
        android:maxHeight="6dp"
        android:splitTrack="false"
        app:layout_constraintTop_toBottomOf="@+id/artistText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/elapsedTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0:00"
        android:textColor="@color/deep_text_secondary"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@+id/seekBar"
        app:layout_constraintStart_toStartOf="@+id/seekBar" />

    <TextView
        android:id="@+id/totalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0:00"
        android:textColor="@color/deep_text_secondary"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@+id/seekBar"
        app:layout_constraintEnd_toEndOf="@+id/seekBar" />

    <!-- Main Controls Section -->
    <LinearLayout
        android:id="@+id/mainControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/elapsedTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <ImageButton
            android:id="@+id/repeatButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_repeat"
            android:alpha="0.6"
            android:contentDescription="@string/action_repeat" />
            
        <ImageButton
            android:id="@+id/prevButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_ghost_button"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_prev"
            android:contentDescription="@string/action_previous" />
            
        <ImageButton
            android:id="@+id/playPauseButton"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_primary_button"
            android:padding="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            android:contentDescription="@string/action_play" />
            
        <ImageButton
            android:id="@+id/nextButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_ghost_button"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_next"
            android:contentDescription="@string/action_next" />
            
        <ImageButton
            android:id="@+id/favoriteButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_favorite_border"
            android:contentDescription="@string/action_favorite" />
    </LinearLayout>

    <!-- Utility Section -->
    <LinearLayout
        android:id="@+id/utilityControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/mainControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <Button
            android:id="@+id/v4aButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ghost_button"
            android:text="V4A"
            android:textAllCaps="false"
            android:textColor="@color/deep_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
            
        <ImageButton
            android:id="@+id/downloadButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_ghost_button"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_downloads"
            android:contentDescription="@string/action_download" />
            
        <Button
            android:id="@+id/queueButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ghost_button"
            android:text="Queue"
            android:textAllCaps="false"
            android:textColor="@color/deep_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
