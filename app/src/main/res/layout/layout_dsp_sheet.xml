<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_dsp_sheet" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
        <View android:layout_width="44dp" android:layout_height="5dp" android:layout_gravity="center_horizontal" android:background="@drawable/bg_drag_handle" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/dspTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Deep DSP" android:textColor="@color/deep_text_primary" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:id="@+id/dspSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Native pipeline ready" android:textColor="@color/deep_text_secondary" />
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/dspMasterToggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="10-band EQ" android:textColor="@color/deep_text_primary" android:textSize="18sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="12dp" android:gravity="bottom" android:orientation="horizontal" android:weightSum="10">
            <include layout="@layout/item_eq_band" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <include layout="@layout/item_eq_band" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <include layout="@layout/item_eq_band" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <include layout="@layout/item_eq_band" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <include layout="@layout/item_eq_band" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <include layout="@layout/item_eq_band" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <include layout="@layout/item_eq_band" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <include layout="@layout/item_eq_band" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <include layout="@layout/item_eq_band" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <include layout="@layout/item_eq_band" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>
        <Button android:id="@+id/dspReset" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="22dp" android:text="Reset to Flat" />
    </LinearLayout>
</ScrollView>
