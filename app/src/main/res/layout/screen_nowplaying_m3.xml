<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Material 3 Expressive Now Playing - Immersive Full Screen -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">
        
        <!-- Blurred Album Art Background (Placeholder for real implementation) -->
        <ImageView
            android:id="@+id/backgroundArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.15"/>
        
        <!-- Gradient Overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_gradient_surface"/>
        
        <!-- Audio Visualizer Overlay -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/visualizerComposeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        
        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="32dp">
            
            <!-- Drag Handle -->
            <View
                android:layout_width="40dp"
                android:layout_height="6dp"
                android:background="?attr/colorOutline"
                android:alpha="0.4"
                android:layout_marginBottom="32dp"/>
            
            <!-- Album Art - Large with expressive shape -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/artworkImageM3"
                android:layout_width="320dp"
                android:layout_height="320dp"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/ShapeAppearance.Music.NowPlaying"
                android:elevation="12dp"
                android:layout_marginBottom="40dp"/>
            
            <!-- Track Info -->
            <TextView
                android:id="@+id/trackTitleM3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Track Title"
                android:textAppearance="@style/TextAppearance.M3.HeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                android:textAlignment="center"
                android:maxLines="1"
                android:ellipsize="end"/>
            
            <TextView
                android:id="@+id/artistNameM3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Artist Name"
                android:textAppearance="@style/TextAppearance.M3.BodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAlignment="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"/>
            
            <!-- Progress Bar - Material 3 Slider -->
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderM3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="100"
                android:stepSize="1"
                app:trackHeight="6dp"
                app:thumbRadius="8dp"/>
            
            <!-- Time Labels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp">
                
                <TextView
                    android:id="@+id/elapsedTimeM3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textAppearance="@style/TextAppearance.M3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
                
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                
                <TextView
                    android:id="@+id/totalTimeM3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3:45"
                    android:textAppearance="@style/TextAppearance.M3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
            
            <!-- Playback Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="32dp">
                
                <!-- Previous -->
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.IconButton"
                    android:id="@+id/previousButtonM3"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:icon="@drawable/ic_prev"
                    app:iconSize="40dp"
                    app:iconTint="?attr/colorOnSurface"/>
                
                <!-- Play/Pause - Large FAB style -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/playPauseButtonM3"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginHorizontal="32dp"
                    app:shapeAppearance="@style/ShapeAppearance.M3.Full"
                    app:backgroundTint="?attr/colorPrimaryContainer"
                    app:tint="?attr/colorOnPrimaryContainer"
                    app:elevation="8dp"
                    app:pressedTranslationZ="12dp"
                    android:src="@drawable/ic_play"/>
                
                <!-- Next -->
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.IconButton"
                    android:id="@+id/nextButtonM3"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:icon="@drawable/ic_next"
                    app:iconSize="40dp"
                    app:iconTint="?attr/colorOnSurface"/>
            </LinearLayout>
            
            <!-- Secondary Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.IconButton"
                    android:id="@+id/connectButtonM3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_cast"
                    app:iconTint="?attr/colorOnSurfaceVariant"/>
                
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.IconButton"
                    android:id="@+id/favoriteButtonM3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_favorite_border"
                    app:iconTint="?attr/colorOnSurfaceVariant"/>
    
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.IconButton"
                    android:id="@+id/repeatButtonM3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_repeat"
                    app:iconTint="?attr/colorOnSurfaceVariant"/>
    
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.IconButton"
                    android:id="@+id/downloadButtonM3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_download"
                    app:iconTint="?attr/colorOnSurfaceVariant"/>
                    
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.IconButton"
                    android:id="@+id/v4aButtonM3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_equalizer"
                    app:iconTint="?attr/colorOnSurfaceVariant"/>
    
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.IconButton"
                    android:id="@+id/queueButtonM3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_queue"
                    app:iconTint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
            
        </LinearLayout>
        
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
